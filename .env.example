PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sevaconnect
JWT_SECRET=replace-with-a-local-development-secret

# AI Assistant Settings (Free API Keys Available)
AI_PROVIDER=auto

# Ollama Cloud (Open Source Models, no local download required)
# Create a key at: https://ollama.com/settings/keys
OLLAMA_ENABLED=true
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gpt-oss:20b-cloud

# Groq Cloud (Free API Key, Open Source Models like Llama 3.3 70B):
# Sign up free: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Free API Key):
# Sign up free: https://ai.google.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (Optional):
OPENAI_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=